# Upstream OpenAI-compatible endpoint that serves /v1/models.
# ".../v1", ".../v1/models" or a bare base URL all work.
UPSTREAM_BASE_URL=https://your-llm-gateway.example.com
# API key used ONLY for fetching the upstream model list.
UPSTREAM_API_KEY=sk-...

# Re-fetch the upstream model list every N seconds (0 = only at startup / manual).
SYNC_INTERVAL_SECONDS=300

# /v1/model/info forwards each caller's Authorization header to the upstream
# /v1/models and returns only the models that key can access. Successful
# per-key lookups are cached this long (0 = re-check upstream every request).
USER_MODELS_CACHE_TTL_SECONDS=60

# Refresh the models.dev catalog (primary metadata source, no API key needed)
# every N seconds (0 = disable; the last fetched copy is cached on disk). This
# is the only source with cache read/write pricing, above-N-token context tier
# pricing and priority/"fast" service-tier pricing for most models.
MODELSDEV_REFRESH_INTERVAL_SECONDS=86400

# Refresh the LiteLLM community price/metadata map every N seconds (0 = use bundled copy).
PRICES_REFRESH_INTERVAL_SECONDS=86400

# Refresh the OpenRouter public catalog (last-resort metadata source, no API key
# needed) every N seconds (0 = disable; the last fetched copy is cached on disk).
OPENROUTER_REFRESH_INTERVAL_SECONDS=86400

# Directory of per-model override JSON files (default: <DATA_DIR>/overrides).
# One file per model, e.g. {"model_name": "gpt-5.5-fast", "base_model":
# "gpt-5.5", "cost_multiplier": 2.5, "model_info": {...}} — drop files in /
# edit them externally and they are picked up automatically; mount a shared
# folder here to reuse the same overrides across deployments.
#OVERRIDES_DIR=/data/overrides

# Optional bearer token for /modelinfod/api. Leave empty if the proxy layer
# in front already gates access to /modelinfod.
ADMIN_TOKEN=

# Host-side binding used by docker-compose (the app always listens on 8080
# inside the container; do not set PORT here, it would change the in-container
# listen port and break the mapping).
BIND_ADDR=127.0.0.1
HOST_PORT=8080
